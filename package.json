{
  "name": "catch-inbox",
  "private": true,
  "version": "0.2.2",
  "productName": "Catch",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "package:windows": "node scripts/package-windows.mjs",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.16.7",
    "@firebase/auth": "1.13.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@huggingface/transformers": "4.3.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "42.11.18",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0"
  }
}
